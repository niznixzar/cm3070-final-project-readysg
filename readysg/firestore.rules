rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Private progress, streaks, settings and push token. Only the owner.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Emergency info (blood type, allergies, contacts). Only the owner.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Leaderboard data. Any signed-in user can read; only the owner writes.
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0;
      allow delete: if isOwner(uid);
    }

    // Community-mapped emergency resources.
    match /resources/{id} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['aed', 'shelter', 'assembly', 'firstaid', 'lep']
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        // Rough bounding box around Singapore.
        && request.resource.data.lat > 1.15 && request.resource.data.lat < 1.48
        && request.resource.data.lng > 103.6 && request.resource.data.lng < 104.1
        && request.resource.data.verifiedCount == 0
        && request.resource.data.verifiedBy.size() == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.reportedBy.size() == 0;

      // Anyone except the creator can confirm a location once.
      allow update: if signedIn() && (
        (
          changedOnly(['verifiedBy', 'verifiedCount'])
          && resource.data.createdBy != request.auth.uid
          && !(request.auth.uid in resource.data.verifiedBy)
          && request.resource.data.verifiedBy.hasAll(resource.data.verifiedBy)
          && request.auth.uid in request.resource.data.verifiedBy
          && request.resource.data.verifiedBy.size() == resource.data.verifiedBy.size() + 1
          && request.resource.data.verifiedCount == resource.data.verifiedCount + 1
        ) || (
          // Anyone can report a problem once.
          changedOnly(['reportedBy', 'reportCount'])
          && !(request.auth.uid in resource.data.reportedBy)
          && request.resource.data.reportedBy.hasAll(resource.data.reportedBy)
          && request.auth.uid in request.resource.data.reportedBy
          && request.resource.data.reportedBy.size() == resource.data.reportedBy.size() + 1
          && request.resource.data.reportCount == resource.data.reportCount + 1
        )
      );

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Simulated emergency alerts. Read-only for the app; created from the
    // Firebase console, the admin script, or Cloud Functions (which bypass rules).
    match /alerts/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
